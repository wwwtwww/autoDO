<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textSize="12sp"
                android:textColor="@color/primary_blue"
                android:background="@color/light_blue_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 状态主看板 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_global_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_global_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_default"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/error_red_dark"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_global_status_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_desc_default"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.3" />

                <!-- 时段胶囊：工作日生效时结构化展示上/下午随机窗口与今日打卡进度 -->
                <LinearLayout
                    android:id="@+id/layout_status_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/chip_morning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_status_chip"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:lineSpacingExtra="3dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/chip_afternoon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_status_chip"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp"
                        android:lineSpacingExtra="3dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 第一组：核心打卡控制 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_core"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_white"
            app:strokeColor="@color/divider_gray"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 主行动点：填充式大按钮，与次级设置项形成主次分级 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_schedule_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_margin="16dp"
                    android:text="@string/btn_start_guard"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@color/status_green"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_gray"/>

                <!-- 配置打卡周期与时间（含当前值副标题预览） -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_config_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_config_time"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_event"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_title_config_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_config_time"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_config_time"
                        app:layout_constraintEnd_toStartOf="@id/chevron_config_time"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tv_subtitle_config_time"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_subtitle_config_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_config_time"
                        app:layout_constraintEnd_toStartOf="@id/chevron_config_time"
                        app:layout_constraintTop_toBottomOf="@id/tv_title_config_time"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/chevron_config_time"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_gray"/>

                <!-- 管理例外日期（含当前值副标题预览） -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_manage_exceptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_manage_exceptions"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_beach_access"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_title_manage_exceptions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_manage_exceptions"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_manage_exceptions"
                        app:layout_constraintEnd_toStartOf="@id/chevron_manage_exceptions"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tv_subtitle_exceptions"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_subtitle_exceptions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_manage_exceptions"
                        app:layout_constraintEnd_toStartOf="@id/chevron_manage_exceptions"
                        app:layout_constraintTop_toBottomOf="@id/tv_title_manage_exceptions"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/chevron_manage_exceptions"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_gray"/>

                <!-- 查看历史打卡日志 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_view_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_view_logs"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_assignment"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_title_view_logs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_view_logs"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_view_logs"
                        app:layout_constraintEnd_toStartOf="@id/chevron_view_logs"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tv_subtitle_logs"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_subtitle_logs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle_logs"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_view_logs"
                        app:layout_constraintEnd_toStartOf="@id/chevron_view_logs"
                        app:layout_constraintTop_toBottomOf="@id/tv_title_view_logs"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/chevron_view_logs"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 第二组：权限管理 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_permissions"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_white"
            app:strokeColor="@color/divider_gray"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- 无障碍 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_enable_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_accessibility"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_accessibility"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_accessibility_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/title_accessibility"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_accessibility"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_accessibility"
                        app:layout_constraintBottom_toTopOf="@id/tv_accessibility_desc"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_accessibility_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_accessibility"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_accessibility"
                        app:layout_constraintTop_toBottomOf="@id/tv_accessibility_title"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_accessibility"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_status_accessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_unauthorized"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_red"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_light"/>

                <!-- 自启动 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_auto_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_auto_start"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_autorenew"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_autostart_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/title_auto_start"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_auto_start"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_autostart"
                        app:layout_constraintBottom_toTopOf="@id/tv_autostart_desc"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_autostart_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_auto_start"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_auto_start"
                        app:layout_constraintTop_toBottomOf="@id/tv_autostart_title"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_autostart"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_status_autostart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_go_config"
                        android:textSize="13sp"
                        android:textColor="@color/primary_blue"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_light"/>

                <!-- 电池优化 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_battery_optimization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_battery"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_battery"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_battery_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/title_battery"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_battery"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_battery"
                        app:layout_constraintBottom_toTopOf="@id/tv_battery_desc"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_battery_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_battery"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_battery"
                        app:layout_constraintTop_toBottomOf="@id/tv_battery_title"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_battery"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_status_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_not_closed"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_red"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_light"/>

                <!-- 悬浮窗（P0：整行可点，直接跳转授权页） -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_overlay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_chat_bubble"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_overlay_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/title_overlay"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_overlay"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_overlay"
                        app:layout_constraintBottom_toTopOf="@id/tv_overlay_desc"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_overlay_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_overlay"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_overlay"
                        app:layout_constraintTop_toBottomOf="@id/tv_overlay_title"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_overlay"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_status_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_unauthorized"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_red"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_light"/>

                <!-- 精确闹钟（P0：整行可点，直接跳转授权页） -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_alarm"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_alarm"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_alarm_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/title_alarm"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_alarm"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_alarm"
                        app:layout_constraintBottom_toTopOf="@id/tv_alarm_desc"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_alarm_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_alarm"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_alarm"
                        app:layout_constraintTop_toBottomOf="@id/tv_alarm_title"
                        app:layout_constraintEnd_toStartOf="@id/tv_status_alarm"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_status_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_not_ready"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_red"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="76dp"
                    android:background="@color/divider_light"/>

                <!-- 前台保活通知开关（P0：重构为与权限行一致的 Switch 列表项） -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_keepalive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/icon_keepalive"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_badge"
                        android:padding="8dp"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/primary_blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_keepalive_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/title_keepalive"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/icon_keepalive"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/switch_keepalive"
                        app:layout_constraintBottom_toTopOf="@id/tv_keepalive_desc"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_keepalive_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_keepalive"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        app:layout_constraintStart_toEndOf="@id/icon_keepalive"
                        app:layout_constraintTop_toBottomOf="@id/tv_keepalive_title"
                        app:layout_constraintEnd_toStartOf="@id/switch_keepalive"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_keepalive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 第三组：测试功能 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_test"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_white"
            app:strokeColor="@color/divider_gray"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/test_warning_title"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning_red"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/test_warning_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingMultiplier="1.3"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_unlock"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="@string/btn_test_unlock"
                        android:textSize="13sp"
                        android:textColor="@color/primary_blue"
                        app:strokeColor="@color/primary_blue"
                        app:cornerRadius="10dp"
                        android:layout_marginEnd="4dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_clock_in"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="@string/btn_test_clock_in"
                        android:textSize="13sp"
                        android:textColor="@color/primary_blue"
                        app:strokeColor="@color/primary_blue"
                        app:cornerRadius="10dp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
